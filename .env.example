# Required in production. Generate a unique value with at least 32 random bytes.
AUTH_SESSION_SECRET=

# Configure the matching secret in each courier's webhook dashboard.
DTDC_WEBHOOK_SECRET=
SHADOWFAX_WEBHOOK_SECRET=
COURIER_WEBHOOK_SECRET=

# Database configuration.
USE_MONGODB=false
MONGODB_URI=

# Optional integrations.
GOOGLE_SHEET_WEBHOOK_URL=
WALABZ_BASE_URL=https://labzwaba.com
WALABZ_USERNAME=
WALABZ_PASSWORD=
WALABZ_API_KEY=
WHATSAPP_DEVICE_ID=
WHATSAPP_ACCESS_TOKEN=
NEXT_PUBLIC_APP_URL=
APP_PUBLIC_URL=https://oms.ayurvedacare.store
PACKING_SLIP_MEDIA_SECRET=

# DTDC credentials. Keep actual values in .env.local or the deployment secret manager.
DTDC_API_KEY=
DTDC_USERNAME=
DTDC_PASSWORD=
DTDC_ACCESS_TOKEN=
DTDC_CUSTOMER_CODE=

# XpressBees credentials.
XPRESSBEES_API_KEY=
XPRESSBEES_EMAIL=
XPRESSBEES_PASSWORD=
XPRESSBEES_SECRET_KEY=
XPRESSBEES_XB_KEY=
XPRESSBEES_AIR_EMAIL=
XPRESSBEES_AIR_PASSWORD=
XPRESSBEES_AIR_SECRET_KEY=
XPRESSBEES_AIR_XB_KEY=
XPRESSBEES_SURFACE_EMAIL=
XPRESSBEES_SURFACE_PASSWORD=
XPRESSBEES_SURFACE_SECRET_KEY=
XPRESSBEES_SURFACE_XB_KEY=

# Other courier credentials.
DELHIVERY_API_KEY=
SHADOWFAX_API_KEY=

# Development-only switches. Never enable these in production.
DISABLE_OTP=false
ALLOW_UNSIGNED_WEBHOOKS=false
ALLOW_COURIER_SIMULATION=false
NEXT_PUBLIC_ENABLE_DEMO_TOOLS=false
ENABLE_SUPERADMIN_BYPASS=false
NEXT_PUBLIC_ENABLE_SUPERADMIN_BYPASS=false
# Optional: choose a specific active Super Admin account. Defaults to the first active one.
DEV_SUPERADMIN_USERNAME=admin
DISABLE_LOCAL_DB_WRITES=false

# Optional production recovery login. Use /login?recovery=1 and a unique 32+ character secret.
ENABLE_SUPERADMIN_RECOVERY=false
SUPERADMIN_RECOVERY_USERNAME=admin
SUPERADMIN_RECOVERY_SECRET=
